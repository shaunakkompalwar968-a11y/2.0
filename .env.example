# Pooja Garden Environment Variables

# Django Backend
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database (leave empty to automatically use SQLite fallback, or provide PostgreSQL URL)
# Example for Docker Compose PostgreSQL:
DATABASE_URL=postgres://poojagarden:poojasecret123@db:5432/poojagarden_db
# Or leave empty for SQLite fallback:
# DATABASE_URL=

# PostgreSQL (for docker-compose)
POSTGRES_DB=poojagarden_db
POSTGRES_USER=poojagarden
POSTGRES_PASSWORD=poojasecret123

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
